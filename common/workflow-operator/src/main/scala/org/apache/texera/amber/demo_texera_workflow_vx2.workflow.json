        "code": "from typing import Iterator, Optional, Union\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom pytexera import *\nfrom core.models.schema.attribute_type import AttributeType\nclass ProcessTableOperator(UDFTableOperator):\n\n    def open(self) -> None:\n        self.output_file = 'clean_sp500_2000.csv'\n        # Temporary hardcoded default for UI parameter 'output_file' from the source script.\n        # self.UiParameter('output_file', AttributeType.STRING)  # UiParameter disabled for now\n\n    @overrides\n    def process_table(self, table: Table, port: int) -> Iterator[Optional[TableLike]]:\n        table.to_csv(self.output_file, index=False)\n        print(f'\\nStep 5: Load data')\n        print(f'Saved cleaned data to: {self.output_file}')\n        yield table\n\n    def close(self) -> None:\n        pass\n",
